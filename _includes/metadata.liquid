{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign site_url = site.baseurl | prepend: site.url %}
{% assign page_url = page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' %}
{% assign is_home = false %}
{% if page.url == '/' or page.url == '/index.html' %}{% assign is_home = true %}{% endif %}

{% comment %} Pages generated by jekyll-scholar for a single publication carry the bibtex entry in page.entry {% endcomment %}
{% assign is_paper = false %}
{% if page.entry and page.entry.key %}{% assign is_paper = true %}{% endif %}

{% comment %} Description: explicit meta_description > page description > paper abstract > site description {% endcomment %}
{% if page.meta_description %}
  {% assign page_description = page.meta_description %}
{% elsif page.description and page.description != '' %}
  {% assign page_description = page.description %}
{% elsif is_paper and page.entry.abstract %}
  {% assign page_description = page.entry.abstract | strip_html | strip_newlines | truncate: 300 %}
{% else %}
  {% assign page_description = site.description %}
{% endif %}
{% assign page_description = page_description | strip_html | strip_newlines | strip | replace: '  ', ' ' %}

{% comment %} Preview image: per-page og_image > publication first page / thumbnail > site og_image {% endcomment %}
{% assign preview_image = '' %}
{% if page.og_image %}
  {% assign preview_image = page.og_image %}
{% elsif is_paper %}
  {% capture firstpage_exists %}{% file_exists assets/img/publication_firstpage/{{ page.entry.key }}.png %}{% endcapture %}
  {% if firstpage_exists == 'true' %}
    {% assign preview_image = page.entry.key | prepend: '/assets/img/publication_firstpage/' | append: '.png' %}
  {% elsif page.entry.preview %}
    {% if page.entry.preview contains '://' %}
      {% assign preview_image = page.entry.preview %}
    {% else %}
      {% assign preview_image = page.entry.preview | prepend: '/assets/img/publication_preview/' %}
    {% endif %}
  {% endif %}
{% endif %}
{% if preview_image == '' and site.og_image %}
  {% assign preview_image = site.og_image %}
{% endif %}
{% unless preview_image == '' or preview_image contains '://' %}
  {% assign preview_image = preview_image | prepend: site_url %}
{% endunless %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
{% if site.title == 'blank' %}
  {% capture title %}{{ author_name }}{% endcapture %}
{% else %}
  {% capture title %}{{ site.title }}{% endcapture %}
{% endif %}
{% if page.url == '/blog/index.html' %}
  {% capture page_title %}{{ page.title }} | {{ title }}{% endcapture %}
{% elsif page.title != 'blank' and is_home == false %}
  {% if page.title == null or page.title == '' %}
    {% capture page_title %}{{ page.date | date: '%Y' }} | {{ title }}{% endcapture %}
  {% else %}
    {% capture page_title %}{{ page.title }} | {{ title }}{% endcapture %}
  {% endif %}
{% else %}
  {% capture page_title %}{{ title }}{% endcapture %}
{% endif %}
<title>{{ page_title | strip_html | strip }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ page_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}
{% if is_paper %}
  <!-- Google Scholar / Highwire tags so the paper page is indexed as a scholarly article -->
  <meta name="citation_title" content="{{ page.entry.title | strip_html | escape }}">
  {% for author in page.entry.author_array %}
    {% assign citation_author = author.first | append: ' ' | append: author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
    <meta name="citation_author" content="{{ citation_author | strip | escape }}">
  {% endfor %}
  {% if page.entry.year %}
    <meta name="citation_publication_date" content="{{ page.entry.year }}">
  {% endif %}
  {% if page.entry.journal %}
    <meta name="citation_journal_title" content="{{ page.entry.journal | strip_html | escape }}">
  {% elsif page.entry.booktitle %}
    <meta name="citation_conference_title" content="{{ page.entry.booktitle | strip_html | escape }}">
  {% endif %}
  {% if page.entry.doi %}
    <meta name="citation_doi" content="{{ page.entry.doi }}">
  {% endif %}
  {% if page.entry.pdf contains '://' %}
    <meta name="citation_pdf_url" content="{{ page.entry.pdf }}">
  {% elsif page.entry.pdf %}
    <meta name="citation_pdf_url" content="{{ page.entry.pdf | prepend: '/assets/pdf/' | prepend: site_url }}">
  {% endif %}
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:type" content="{% if is_blog_post or is_paper %}article{% elsif is_home %}profile{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | strip_html | strip | escape }}">
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:description" content="{{ page_description | escape }}">
  {% if preview_image != '' %}
    <meta property="og:image" content="{{ preview_image }}">
  {% endif %}
  <meta property="og:locale" content="en_US">
  {% if is_home %}
    <meta property="profile:first_name" content="{{ site.first_name }}">
    <meta property="profile:last_name" content="{{ site.last_name }}">
  {% endif %}

  <!-- Twitter card -->
  <meta name="twitter:card" content="{% if preview_image != '' %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ page_title | strip_html | strip | escape }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">
  {% if preview_image != '' %}
    <meta name="twitter:image" content="{{ preview_image }}">
  {% endif %}
  {% if site.data.socials.x_username %}
    <meta name="twitter:site" content="@{{ site.data.socials.x_username }}">
    <meta name="twitter:creator" content="@{{ site.data.socials.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% comment %} Profile URLs for the "sameAs" property, read from _data/socials.yml {% endcomment %}
  {% assign sameaslinks = '' | split: ',' %}
  {% for social in site.data.socials %}
    {% assign link = '' %}
    {% case social[0] %}
      {% when 'orcid_id' %}{% assign link = social[1] | prepend: 'https://orcid.org/' %}
      {% when 'scholar_userid' %}{% assign link = social[1] | prepend: 'https://scholar.google.com/citations?user=' %}
      {% when 'semanticscholar_id' %}{% assign link = social[1] | prepend: 'https://www.semanticscholar.org/author/' %}
      {% when 'research_gate_profile' %}{% assign link = social[1] | prepend: 'https://www.researchgate.net/profile/' %}
      {% when 'scopus_id' %}{% assign link = social[1] | prepend: 'https://www.scopus.com/authid/detail.uri?authorId=' %}
      {% when 'github_username' %}{% assign link = social[1] | prepend: 'https://github.com/' %}
      {% when 'gitlab_username' %}{% assign link = social[1] | prepend: 'https://gitlab.com/' %}
      {% when 'linkedin_username' %}{% assign link = social[1] | prepend: 'https://www.linkedin.com/in/' %}
      {% when 'x_username' %}{% assign link = social[1] | prepend: 'https://twitter.com/' %}
      {% when 'mastodon_username' %}{% assign link = social[1] | prepend: 'https://' %}
      {% when 'bluesky_url' %}{% assign link = social[1] %}
      {% when 'dblp_url' %}{% assign link = social[1] %}
      {% when 'work_url' %}{% assign link = social[1] %}
      {% when 'blogger_url' %}{% assign link = social[1] %}
      {% when 'wikidata_id' %}{% assign link = social[1] | prepend: 'https://www.wikidata.org/wiki/' %}
      {% when 'youtube_id' %}{% assign link = social[1] | prepend: 'https://youtube.com/@' %}
      {% when 'instagram_id' %}{% assign link = social[1] | prepend: 'https://instagram.com/' %}
      {% when 'facebook_id' %}{% assign link = social[1] | prepend: 'https://facebook.com/' %}
      {% when 'stackoverflow_id' %}{% assign link = social[1] | prepend: 'https://stackoverflow.com/users/' %}
      {% when 'kaggle_id' %}{% assign link = social[1] | prepend: 'https://www.kaggle.com/' %}
      {% when 'zotero_username' %}{% assign link = social[1] | prepend: 'https://www.zotero.org/' %}
      {% when 'osf_id' %}{% assign link = social[1] | prepend: 'https://osf.io/' %}
      {% when 'lattes_id' %}{% assign link = social[1] | prepend: 'http://lattes.cnpq.br/' %}
      {% when 'publons_id' %}{% assign link = social[1] | prepend: 'https://publons.com/a/' %}
    {% endcase %}
    {% if link != '' %}
      {% assign sameaslinks = sameaslinks | push: link %}
    {% endif %}
  {% endfor %}

  {% capture person_json %}
    {
      "@type": "Person",
      "@id": "{{ site_url }}/#person",
      "name": "{{ author_name }}",
      "givenName": "{{ site.first_name }}",
      "familyName": "{{ site.last_name }}",
      "url": "{{ site_url }}/",
      {% if site.og_image %}
        "image": "{% if site.og_image contains '://' %}{{ site.og_image }}{% else %}{{ site.og_image | prepend: site_url }}{% endif %}",
      {% endif %}
      "jobTitle": "Postdoctoral Researcher",
      "affiliation": {
        "@type": "Organization",
        "name": "Institute of Neuroinformatics, University of Zurich and ETH Zurich",
        "url": "https://www.ini.uzh.ch/"
      },
      "alumniOf": [
        { "@type": "CollegeOrUniversity", "name": "University of Waterloo" },
        { "@type": "CollegeOrUniversity", "name": "McMaster University" }
      ],
      "knowsAbout": [
        "computational neuroscience",
        "theoretical neuroscience",
        "spatial cognition",
        "spatial semantic pointers",
        "vector symbolic architectures",
        "spiking neural networks",
        "predictive coding",
        "reinforcement learning"
      ]{% if sameaslinks.size > 0 %},
      "sameAs": {{ sameaslinks | jsonify }}{% endif %}
    }
  {% endcapture %}

  <script type="application/ld+json">
    {% if is_paper %}
      {
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "headline": {{ page.entry.title | strip_html | jsonify }},
        "name": {{ page.entry.title | strip_html | jsonify }},
        "url": "{{ page_url }}",
        {% if page.entry.doi %}
          "sameAs": "https://doi.org/{{ page.entry.doi }}",
          "identifier": "https://doi.org/{{ page.entry.doi }}",
        {% endif %}
        {% if page.entry.abstract %}
          "abstract": {{ page.entry.abstract | strip_html | strip_newlines | jsonify }},
        {% endif %}
        {% if page.entry.year %}
          "datePublished": "{{ page.entry.year }}",
        {% endif %}
        {% if page.entry.journal or page.entry.booktitle %}
          "isPartOf": {
            "@type": "Periodical",
            "name": {{ page.entry.journal | default: page.entry.booktitle | strip_html | jsonify }}
          },
        {% endif %}
        {% if preview_image != '' %}
          "image": "{{ preview_image }}",
        {% endif %}
        "author": [
          {% for author in page.entry.author_array %}
            {% assign clean_first = author.first | regex_replace: '[*∗†‡§¶‖&^]', '' | strip %}
            {% assign clean_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' | strip %}
            {% assign is_self = false %}
            {% if site.scholar.last_name contains clean_last and site.scholar.first_name contains clean_first %}{% assign is_self = true %}{% endif %}
            {% if is_self %}
              { "@id": "{{ site_url }}/#person", "@type": "Person", "name": "{{ author_name }}" }
            {% else %}
              { "@type": "Person", "name": {{ clean_first | append: ' ' | append: clean_last | jsonify }} }
            {% endif %}
            {% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    {% elsif is_home %}
      {
        "@context": "https://schema.org",
        "@graph": [
          {{ person_json }},
          {
            "@type": "WebSite",
            "@id": "{{ site_url }}/#website",
            "url": "{{ site_url }}/",
            "name": "{{ title }}",
            "description": "{{ page_description | escape }}",
            "author": { "@id": "{{ site_url }}/#person" }
          },
          {
            "@type": "ProfilePage",
            "url": "{{ site_url }}/",
            "mainEntity": { "@id": "{{ site_url }}/#person" }
          }
        ]
      }
    {% else %}
      {
        "@context": "https://schema.org",
        "@type": "{% if is_blog_post %}BlogPosting{% else %}WebPage{% endif %}",
        "url": "{{ page_url }}",
        "name": "{{ page_title | strip_html | strip | escape }}",
        "headline": "{{ page.title | default: title | escape }}",
        "description": "{{ page_description | escape }}",
        "isPartOf": { "@id": "{{ site_url }}/#website" },
        "author": { "@id": "{{ site_url }}/#person", "@type": "Person", "name": "{{ author_name }}" }
      }
    {% endif %}
  </script>
{% endif %}
