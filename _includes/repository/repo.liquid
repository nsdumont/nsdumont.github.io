{% assign repo_parts = include.repository.repo | split: '/' %}
{% if site.data.repositories.github_users contains repo_parts.first %}
  {% assign repo_label = repo_parts.last %}
{% else %}
  {% assign repo_label = include.repository.repo %}
{% endif %}

<li class="repo-item">
  <a class="repo-title" href="https://github.com/{{ include.repository.repo }}" target="_blank" rel="noopener">
    <i class="fa-brands fa-github"></i> {{ repo_label }}
  </a>
  {% if include.repository.description %}
    <p class="repo-description">{{ include.repository.description }}</p>
  {% endif %}
  {% if include.repository.topics and include.repository.topics.size > 0 %}
    <div class="repo-topics">
      {% for topic in include.repository.topics %}
        <span class="repo-topic">{{ topic }}</span>
      {% endfor %}
    </div>
  {% endif %}
</li>
