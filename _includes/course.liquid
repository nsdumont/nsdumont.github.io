{% assign course = include.course %}
<li class="course-item">
  <div class="course-title">
    {{ course.title }}
    {% if course.code %}<span class="course-code">{{ course.code }}</span>{% endif %}
  </div>
  <div class="course-meta">
    {% if course.role %}<span class="course-role">{{ course.role }}</span>{% endif %}
    <span class="course-where">
      {% if course.term %}{{ course.term }}, {% endif %}{{ course.institution }}
    </span>
  </div>
  {% if course.links and course.links.size > 0 %}
    <div class="course-links">
      {% for link in course.links %}
        {% if link.url contains '://' %}
          <a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>
        {% else %}
          <a href="{{ link.url | relative_url }}" target="_blank" rel="noopener">{{ link.label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</li>
