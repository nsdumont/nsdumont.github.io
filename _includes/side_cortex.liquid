<div
  class="side-art side-cortex"
  aria-hidden="true"
  data-width="{{ site.side_art.cortex.width | default: 200 }}"
  data-seed="{{ site.side_art.cortex.seed | default: 0 }}"
  data-animate="{{ site.side_art.cortex.animate | default: true }}"
  data-pulse-interval="{{ site.side_art.cortex.pulse_interval | default: 6 }}"
  data-scroll-amplitude="{{ site.side_art.cortex.scroll_amplitude | default: 0.35 }}"
  data-scroll-period="{{ site.side_art.cortex.scroll_period | default: 600 }}"
></div>
<script src="{{ '/assets/js/side-cortex.js' | relative_url | bust_file_cache }}"></script>
